server <- function(input, output, session) {
connection <- open_workbench_database(database_path)
initialise_workbench_database(connection, schema_path)
session$onSessionEnded(function() DBI::dbDisconnect(connection, shutdown = TRUE))
refresh <- shiny::reactiveVal(0L)
source_snapshots_server("snapshots", connection, refresh)
format_explorer_server("explorer", connection, refresh)
import_page_server("import", connection, examples, refresh)
}
shiny::shinyApp(ui, server)
source_calls <- sys.calls()
source_call_indexes <- which(vapply(source_calls, function(call) {
identical(as.character(call[[1L]])[[1L]], "source")
}, logical(1)))
source_files <- unlist(lapply(rev(source_call_indexes), function(index) {
tryCatch(
eval(source_calls[[index]][[2L]], envir = sys.frame(max(1L, index - 1L))),
error = function(error) NULL
)
}), use.names = FALSE)
source_files <- as.character(source_files)
source_files <- source_files[!is.na(source_files) & file.exists(source_files)]
app_source_path <- if (length(source_files) > 0L) {
normalizePath(source_files[[1L]], winslash = "/", mustWork = TRUE)
} else {
NA_character_
}
configured_root <- Sys.getenv("FORMAT_POLICY_WORKBENCH_ROOT", unset = "")
bootstrap_path <- if (nzchar(configured_root)) {
normalizePath(configured_root, winslash = "/", mustWork = TRUE)
} else if (!is.na(app_source_path)) {
dirname(app_source_path)
} else {
getwd()
}
source(file.path(bootstrap_path, "R", "paths.R"))
project_root <- find_workbench_project_root(bootstrap_path)
source(file.path(project_root, "R", "parser-common.R"))
source(file.path(project_root, "R", "pronom-schema.R"))
source(file.path(project_root, "R", "import-pronom-json.R"))
